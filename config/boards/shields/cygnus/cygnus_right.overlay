#include "cygnus.dtsi"

// Cygnus PCBs are SYMMETRIC (not mirrored): right half uses same GPIO pin
// order as left, just shifted to cols 6..10 of the shared matrix.
// Left half = cols 0..9 via five_column_transform (skipping col 0).
// Right half = cols 6..10 via identical five_column_transform, no reversal.

&five_column_transform {
    columns = <5>;
    rows = <4>;
    map = <
        RC(0,6) RC(0,7) RC(0,8) RC(0,9) RC(0,10)
        RC(1,6) RC(1,7) RC(1,8) RC(1,9) RC(1,10)
        RC(2,6) RC(2,7) RC(2,8) RC(2,9) RC(2,10)
                 RC(3,6) RC(3,7) RC(3,8)
    >;
};
