#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include "keymap_german.h"

// Layer definitions

#define BASE 0
#define NAV 1
#define SYM 2
#define FNC 3
#define SYS 4

// -----------------

/ {
    combos {
        compatible = "zmk,combos";

        // R + T -> colon (:)
        combo_colon {
            timeout-ms = <200>;
            key-positions = <11 12>;   // R=11, T=12 (Gallium colstag)
            bindings = <&kp DE_COLN>;
        };

        // --- sys layer combos (adapted to 3x5+3 geometry) ---

        system_reset {
            timeout-ms = <200>;
            key-positions = <0 1 2>;          // B+L+D chord
            bindings = <&sys_reset>;
        };

        bootloader_combo {
            timeout-ms = <200>;
            key-positions = <15 16 17>;       // J+Y+O chord
            bindings = <&bootloader>;
        };

        system_layer_combo {
            timeout-ms = <200>;
            key-positions = <31 30>;          // left inner+middle thumb
            bindings = <&mo 3>;
        };

        space_cmb {
            bindings = <&kp SPACE>;
            key-positions = <23 24>;
        };

        r_alt_cmb {
            bindings = <&kp RALT>;
            key-positions = <28 29>;
        };

        l_ctrl_cmb {
            bindings = <&kp LCTRL>;
            key-positions = <20 21>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        num_sym_to_fnc {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //
        // Layout: Gallium (Columnar Staggered) — base from GalileoBlues/Gallium
        // Num/Sym layers copied from cygnus-zmk-layout; Thumb from its gallium_layer
        // Notation: · = &none (unbound) | trn = &trans | FNC = hold layer 3
        // Physical (five_column_transform): 3 rows x 5 cols + 3 thumb keys/half
        //   thumb drawn under cols 3-5 (left) / 6-8 (right)
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // | B | L | D | C | V |   | J | Y | O | U | , |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | N | R | T | S | G |   | P | H | A | E | I |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | X | Q | M | W | Z |   | K | F | ' | ; | . |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         |ALT|SYM|GUI|   |CTL|NAV|SFT|
        //         ├───┼───┼───┤   ├───┼───┼───┤
        //         |ESC|TAB|SPC|   |ENT|DEL|BSP|
        //         └───┴───┴───┘   └───┴───┴───┘

        gallium_layer {
            display-name = "Gallium";
            bindings = <
&kp B  &kp L  &kp D  &kp C         &kp V      &kp J           &kp Y            &kp O        &kp U                 &kp DE_COMM
&kp N  &kp R  &kp T  &kp S         &kp G      &kp P           &kp H            &kp A        &kp E                 &kp I
&kp X  &kp Q  &kp M  &kp W         &kp Z      &kp K           &kp F            &kp DE_APOS  &kp DE_SCLN           &kp DE_DOT
                     &mt LALT ESC  &lt 2 TAB  &mt LGUI SPACE  &mt LCTRL ENTER  &lt 1 DEL    &mt LSHIFT BACKSPACE
            >;
        };

        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // |F1 |F2 |F3 |F4 |F5 |   | / | 1 | 2 | 3 | + |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |F7 |F8 |F9 |F10|F11|   | * | 4 | 5 | 6 | - |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |PS |CR |HO |EN |PU |   |F12| 7 | 8 | 9 | . |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         |trn|FNC|trn|   |trn| 0 |trn|
        //         └───┴───┴───┘   └───┴───┴───┘

        nav_layer {
            display-name = "NavNum";
            bindings = <
&kp F1     &kp F2    &kp F3    &kp F4   &kp F5     &kp KP_DIVIDE    &kp N1  &kp N2  &kp N3  &kp KP_PLUS
&kp F7     &kp F8    &kp F9    &kp F10  &kp F11    &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_MINUS
&kp PSCRN  &kp CAPS  &kp HOME  &kp END  &kp PG_UP  &kp F12          &kp N7  &kp N8  &kp N9  &kp DOT
                               &trans   &mo 3      &trans           &trans  &kp N0  &trans
            >;
        };

        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // | ` | ~ | [ | ] | % |   | ^ | & | * | ! | ? |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | \ | ( | ) | ( | ] |   | < | > | = | ; | : | / |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | | | # | < | " | @ |   | _ | + | ' | ; | $ |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         |trn|trn|trn|   |trn|FNC|trn|
        //         └───┴───┴───┘   └───┴───┴───┘

        sym_layer {
            display-name = "Symbl";
            bindings = <
&kp GRAVE  &kp TILDE  &kp LBRC  &kp RBRC  &kp PERCENT  &kp CARET  &kp AMPS   &kp ASTERISK  &kp EXCLAMATION  &kp QUESTION
&kp BSLH   &kp LBKT   &kp LPAR  &kp RPAR  &kp RBKT     &kp GT     &kp EQUAL  &kp COLON     &kp MINUS        &kp FSLH
&kp PIPE   &kp HASH   &kp LT    &kp DQT   &kp AT_SIGN  &kp UNDER  &kp PLUS   &kp SQT       &kp SEMI         &kp DOLLAR
                                &trans    &trans       &trans     &trans     &mo 3         &trans
            >;
        };

        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // |F1 |F2 |F3 |F4 |F5 |   |F6 |F7 |F8 |F9 |F10|
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |ALT|WIN|SFT|CTL|ALR|   |WSL|WSD|WSU|WSR| · |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |F11|F12| · | · |REP|   |WL |WD |WU |WR |S10|
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         | · |trn|trn|   |trn|trn| · |
        //         └───┴───┴───┘   └───┴───┴───┘
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // |PRV|NXT| . | . | . |   | . |UP | . | . | . |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |S0 |S1 |S2 |S3 |S4 |   |LF |DN |RG | . | . |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |BOO|RST|CLR|CLA| . |   | . | . | . | . | . |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //   (reach via left inner+middle thumb chord: pos 31+32)

        sys_layer {
            display-name = "Sys";
            bindings = <
&bt BT_PRV    &bt BT_NXT    &trans        &trans          &trans        &trans  &trans    &kp UP_ARROW    &trans           &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3    &bt BT_SEL 4  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT_ARROW  &trans
&bootloader   &sys_reset    &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans  &trans    &trans          &trans           &trans
                                          &trans          &trans        &trans  &trans    &trans          &trans
            >;
        };
    };
};
