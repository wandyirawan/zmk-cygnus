#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include "keymap_german.h"

// Layer definitions
#define BASE 0
#define NAV 1
#define SYM 2
#define FNC 3
// -----------------

/ {
    behaviors {
        // Enables holding the first mod-tap key
        // by performing a tap-release-hold sequence.
        // To use it: "&qt KEYCODE1 KEYCODE2"
        qt: quick_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };

        smt: sticky_mod_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&sk>;
            display-name = "sticky Mod-Tap";
        };
    };

    combos {
        compatible = "zmk,combos";

        // both left thumb keys
        combo_settings {
            timeout-ms = <200>;
            key-positions = <31 32>;
            bindings = <&none>;
        };

        // inner left + middle right thumb
        combo_num {
            timeout-ms = <200>;
            key-positions = <32 34>;
            bindings = <&none>;
        };

        // NOTE: with Gallium colstag, comma (,), period (.), apostrophe (')
        // and semicolon (;) are direct Base keys, so the old letter-pair
        // combos that produced them were removed.

        // R + T -> colon (:)
        combo_colon {
            timeout-ms = <200>;
            key-positions = <11 12>;   // R=11, T=12
            bindings = <&kp DE_COLN>;
        };

        // P + H -> underscore (_)
        combo_underscore {
            timeout-ms = <200>;
            key-positions = <15 16>;   // P=15, H=16
            bindings = <&kp DE_UNDSC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        num_sym_to_fnc {
            if-layers = <NAV SYM>;
            then-layer = <FNC>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        //
        // Layout: Gallium (Columnar Staggered variant)
        // Notation: · = &none (unbound) | trn = &trans
        // Positions follow five_column_transform:
        // rows 0-2 = 10 keys/half; thumb = 3 keys/half (pos 30-35)
        // drawn under cols 3-5 (left) / 6-8 (right)
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // | B | L | D | C | V |   | J | Y | O | U | , |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | N | R | T | S | G |   | P | H | A | E | I |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | X | Q | M | W | Z |   | K | F |'; | ; | . |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         | · |SFT|NAV|   |SYM|SFT| · |
        //         ├───┼───┼───┤   ├───┼───┼───┤
        //         |   |SPC|BSP|   |ENT|SPC|   |
        //         └───┴───┴───┘   └───┴───┴───┘
        default_layer {
            display-name = "Base";
            bindings = <
            &kp B               &kp L               &kp D               &kp C               &kp V                   &kp J               &kp Y               &kp O               &kp U               &kp DE_COMM
            &kp N               &kp R               &kp T               &kp S               &kp G                   &kp P               &kp H               &kp A               &kp E               &kp I
            &kp X               &kp Q               &kp M               &kp W               &kp Z                   &kp K               &kp F               &kp DE_APOS         &kp DE_SCLN         &kp DE_DOT
            &none               &qt LSHIFT SPACE    &lt NAV BSPC            &lt SYM ENTER       &qt RSHIFT SPACE    &none
        >;
        };
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // | 1 | 2 | 3 | 4 | 5 |   | 6 | 7 | 8 | 9 | 0 |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |ALT|WIN|SFT|CTL|ALR|   |LFT|DWN|UP |RGT| + |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |ESC| · |TAB|DEL|CAP|   |C+B|BSP| , | . | - |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         | · |trn|trn|   |trn|trn| · |
        //         └───┴───┴───┘   └───┴───┴───┘
        nav_layer {
            display-name = "NavNum";
            bindings = <
            &kp N1              &kp N2              &kp N3              &kp N4              &kp N5                  &kp N6              &kp N7              &kp N8              &kp N9              &kp N0
            &smt LALT LALT      &smt LGUI LGUI      &smt LSHIFT LSHIFT  &smt LCTRL LCTRL    &smt RALT RALT          &kp LEFT            &kp DOWN            &kp UP              &kp RIGHT           &kp DE_PLUS
            &kp ESC             &none               &kp TAB             &kp DEL             &kp CAPSLOCK            &kp LC(BSPC)        &kp BSPC            &kp DE_COMM         &kp DE_DOT          &kp DE_MINS
            &none               &trans              &trans                  &trans              &trans              &none
        >;
        };
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // | ! | " | § | $ | % |   | & | / | = | ' | \ |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |ALT|WIN|SFT|CTL|ALR|   | * | ( | { | [ | < |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // | ^ | @ | € | | | # |   | ~ | ) | } | ] | > |
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         | · |trn|trn|   |trn|trn| · |
        //         └───┴───┴───┘   └───┴───┴───┘
        sym_layer {
            display-name = "Symbl";
            bindings = <
            &kp DE_EXCL         &kp DE_DQUOT        &kp DE_SECT         &kp DE_DOLL         &kp DE_PERC             &kp DE_AMPR         &kp DE_SLSH         &kp DE_EQL          &kp DE_APOS         &kp DE_BSLS
            &sk LALT            &sk LGUI            &sk LSHIFT          &sk LCTRL           &sk RALT                &kp DE_ASTRK        &kp DE_LPAR         &kp DE_LCBRC        &kp DE_LBRC         &kp DE_LESS
            &kp DE_CIRC         &kp DE_AT           &kp DE_EURO         &kp DE_PIPE         &kp DE_HASH             &kp DE_TILDE        &kp DE_RPAR         &kp DE_RCBRC        &kp DE_RBRC         &kp DE_GREAT
            &none               &trans              &trans                  &trans              &trans              &none
        >;
        };
        //
        // ┌───┬───┬───┬───┬───┐   ┌───┬───┬───┬───┬───┐
        // |F1 |F2 |F3 |F4 |F5 |   |F6 |F7 |F8 |F9 |F10|
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |ALT|WIN|SFT|CTL|ALR|   |WSL|WSD|WSU|WSR| · |
        // ├───┼───┼───┼───┼───┤   ├───┼───┼───┼───┼───┤
        // |F11|F12| · | · |REP|   |WL |WD |WU |WR |S10|
        // └───┴───┴───┴───┴───┘   └───┴───┴───┴───┴───┘
        //
        //         ┌───┬───┬───┐   ┌───┬───┬───┐
        //         | · |trn|trn|   |trn|trn| · |
        //         └───┴───┴───┘   └───┴───┴───┘
        fun_layer {
            display-name = "Funcs";
            bindings = <
            &kp F1              &kp F2              &kp F3              &kp F4              &kp F5                  &kp F6              &kp F7              &kp F8              &kp F9              &kp F10
            &sk LALT            &sk LGUI            &sk LSHIFT          &sk LCTRL           &sk RALT                &kp LG(LS(LEFT))    &kp LG(LS(DOWN))    &kp LG(LS(UP))      &kp LG(LS(RIGHT))   &none
            &kp F11             &kp F12             &none               &none               &key_repeat             &kp LG(LEFT)        &kp LG(DOWN)        &kp LG(UP)          &kp LG(RIGHT)       &kp LS(F10)
            &none               &trans              &trans                  &trans              &trans              &none
        >;
        };
    };
};
