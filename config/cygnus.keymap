/*
 * Cygnus 3x5+3 — Corne 5-column keymap ported 1:1.
 * Source: wandyirawan/corne-zmk-5-column@51b59df (US keycodes).
 * Flat positions remapped: corne 12-col rows -> 10-col rows,
 * thumbs 36-41 -> 30-35. Layer indices preserved.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Optimize key repeat and debounce

&sk {
    release-after-ms = <2000>;
    quick-release;
};

&caps_word { continue-list = <UNDERSCORE MINUS BACKSPACE>; };

&mt {
    tapping-term-ms = <280>;
    quick-tap-ms = <200>;
    require-prior-idle-ms = <120>;
    flavor = "balanced";
};

&lt {
    tapping-term-ms = <200>;
    quick-tap-ms = <150>;
    require-prior-idle-ms = <100>;
};

/ {
    combos {
        compatible = "zmk,combos";

        combo_bksp {
            timeout-ms = <35>;
            key-positions = <9 8>;
            bindings = <&kp BACKSPACE>;
            require-prior-idle-ms = <100>;
        };

        combo_tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
        };

        combo_shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <20 21>;
        };

        combo_delete {
            bindings = <&kp DELETE>;
            key-positions = <18 19>;
        };

        combo_rshift {
            bindings = <&kp RIGHT_SHIFT>;
            key-positions = <28 29>;
        };

        layout_switch {
            bindings = <&tog 4>;
            key-positions = <30 31 34 35>;
        };

        canary_switch {
            bindings = <&tog 5>;
            key-positions = <32 33 34 35>;
        };

        system_reset {
            bindings = <&sys_reset>;
            key-positions = <2 3 4>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <12 13 14>;
        };

        system_layer_combo {
            bindings = <&mo 3>;
            key-positions = <30 31>;
        };

        undo_combo {
            bindings = <&kp LC(Z)>;
            key-positions = <20 21 22>;
            timeout-ms = <40>;
        };

        copy_combo {
            bindings = <&kp LC(C)>;
            key-positions = <21 22>;
            timeout-ms = <35>;
        };

        paste_combo {
            bindings = <&kp LC(V)>;
            key-positions = <22 23>;
            timeout-ms = <35>;
        };

        // Programming bigram combos from plan.md
        // Bracket pairs

        alt_right_combo {
            bindings = <&kp LEFT_ALT>;
            key-positions = <10 20>;
        };
    };

    macros {
        macro_pluseq: macro_pluseq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp PLUS &kp EQUAL>;
        };

        macro_minuseq: macro_minuseq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp EQUAL>;
        };

        macro_noteq: macro_noteq {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EXCLAMATION &kp EQUAL>;
        };

        macro_arrow: macro_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GREATER_THAN>;
        };

        macro_fatarrow: macro_fatarrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
        };

        macro_parens: macro_parens {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LPAR &kp RPAR>;
        };

        macro_braces: macro_braces {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LBRC &kp RBRC>;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };

    keymap {
        compatible = "zmk,keymap";

        gallium_layer {
            bindings = <
&kp B  &kp L  &kp D  &kp C  &kp V  &kp J  &kp Y  &kp O  &kp U  &kp COMMA
&kp N  &kp R  &kp T  &kp S  &kp G  &kp P  &kp H  &kp A  &kp E  &kp I
&kp X  &kp Q  &kp M  &kp W  &kp Z  &kp K  &kp F  &kp SQT  &kp SEMICOLON  &kp PERIOD
                     &mt LALT ESC  &lt 2 TAB  &mt LGUI SPACE  &mt LCTRL ENTER  &lt 1 BACKSPACE  &mt LSHIFT LS(DELETE)
            >;
        };

        num_layer {
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp KP_DIVIDE  &kp N1  &kp N2  &kp N3  &kp KP_PLUS
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp KP_MULTIPLY  &kp N4  &kp N5  &kp N6  &kp KP_MINUS
&kp PSCRN  &kp CAPS  &kp HOME  &kp END  &kp PG_UP  &kp F12  &kp N7  &kp N8  &kp N9  &kp DOT
                     &trans  &mo 3  &trans  &trans  &trans  &kp N0
            >;
        };

        symbol_layer {
            bindings = <
&kp GRAVE  &kp TILDE  &kp LBRC  &kp RBRC  &kp PERCENT  &kp CARET  &kp AMPS  &kp ASTERISK  &kp EXCLAMATION  &kp QUESTION
&kp BSLH  &kp LBKT  &kp LPAR  &kp RPAR  &kp RBKT  &kp GT  &kp EQUAL  &kp COLON  &kp MINUS  &kp FSLH
&kp PIPE  &kp HASH  &kp LT  &kp DQT  &kp AT_SIGN  &kp UNDER  &kp PLUS  &kp SQT  &kp SEMI  &kp DOLLAR
                     &trans  &trans  &trans  &trans  &mo 3  &trans
            >;
        };

        sys_layer {
            bindings = <
&trans  &trans  &bt BT_PRV  &bt BT_NXT  &trans  &none  &trans  &kp UP  &trans  &trans
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &none
&bootloader  &sys_reset  &none  &bt BT_CLR  &bt BT_CLR_ALL  &none  &trans  &trans  &trans  &trans
                     &trans  &trans  &tog 6  &trans  &trans  &trans
            >;
        };

        qwerty_layer {
            bindings = <
&kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P
&kp A  &kp S  &kp D  &kp F  &kp G  &kp H  &kp J  &kp K  &kp L  &kp SEMI
&kp Z  &kp X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH
                     &mt LEFT_ALT DEL  &lt 1 ESCAPE  &mt LEFT_GUI SPACE  &mt LCTRL ENTER  &lt 2 BACKSPACE  &mt LSHFT BACKSPACE
            >;
        };

        canary_layer {
            bindings = <
&kp W  &kp L  &kp Y  &kp P  &kp B  &kp Z  &kp F  &kp O  &kp U  &kp SQT
&kp C  &kp R  &kp S  &kp T  &kp G  &kp M  &kp N  &kp E  &kp I  &kp A
&kp Q  &kp J  &kp V  &kp D  &kp K  &kp X  &kp H  &kp SLASH  &kp COMMA  &kp PERIOD
                     &mt LALT DEL  &lt 1 ESCAPE  &mt LEFT_GUI SPACE  &mt LCTRL ENTER  &lt 2 TAB  &mt RC(LSHIFT) BACKSPACE
            >;
        };

        mac_layer {
            bindings = <
&kp B  &kp L  &kp D  &kp C  &kp V  &kp J  &kp Y  &kp O  &kp U  &kp COMMA
&kp N  &kp R  &kp T  &kp S  &kp G  &kp P  &kp H  &kp A  &kp E  &kp I
&kp X  &kp Q  &kp M  &kp W  &kp Z  &kp K  &kp F  &kp SQT  &kp SEMICOLON  &kp PERIOD
                     &mt LGUI ESC  &lt 2 TAB  &mt LALT SPACE  &mt LCTRL ENTER  &lt 1 DEL  &mt LSHIFT BACKSPACE
            >;
        };
    };
};
